{
  "name": "uriis-challenge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Team workspace for URIIS Student Biz Innov Challenge 2026",
  "scripts": {
    "setup": "bun install && bun run skills:link",
    "skills:link": "node scripts/link-skills.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "frontend:dev": "cd frontend && bun install && bun run dev",
    "frontend:build": "cd frontend && bun install && bun run build",
    "prepare": "husky",
    "demo:check": "node scripts/demo/check-shots.mjs",
    "demo:record": "node scripts/demo/record.mjs",
    "demo:encode": "bash scripts/demo/encode.sh",
    "demo:test": "bun test scripts/demo/record.test.ts scripts/demo/check-shots.test.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.7.1",
    "@commitlint/config-conventional": "^19.7.1",
    "husky": "^9.1.7",
    "playwright": "1.62.0",
    "prettier": "^3.9.6"
  }
}
