bunx commitlint --edit "$1" || {
  echo ""
  echo "  ----------------------------------------------------------------"
  echo "  Your commit message was rejected. This is easy to fix."
  echo ""
  echo "  Start the message with what kind of change it is, then a colon:"
  echo ""
  echo "    docs: add rural track research notes"
  echo "    feat: add impact numbers to the canvas copy"
  echo "    fix: correct the submission deadline in the timeline"
  echo "    chore: install the pitch deck skill"
  echo ""
  echo "  Most of our work is writing, so 'docs:' is usually right."
  echo ""
  echo "  The full list: feat, fix, refactor, docs, test, chore, style, perf"
  echo ""
  echo "  Rules: lowercase after the colon, no full stop at the end,"
  echo "  and keep the first line under 100 characters."
  echo ""
  echo "  Nothing is lost. Just run your commit again with a new message."
  echo "  ----------------------------------------------------------------"
  echo ""
  exit 1
}
